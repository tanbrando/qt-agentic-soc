# ==============================================================================
# CẤU HÌNH MẪU TẬP TRUNG CHO HỆ THỐNG ASP (SERVER + AGENT CLIENT + OPERATOR)
# Sao chép file này thành .env (cp .env.example .env) và điền giá trị thực tế.
# TUYỆT ĐỐI KHÔNG điền khóa thật vào .env.example và KHÔNG commit file .env lên Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CẤU HÌNH SERVER & DATABASE (Dùng cho Server, asp_migrate.py, asp_admin.py, asp_reparse.py)
# ------------------------------------------------------------------------------

# Chuỗi kết nối PostgreSQL 17 theo định dạng: postgresql://<user>:<password>@<host>:<port>/<db_name>
# Dùng để lưu trữ events_raw, events, alerts, cases, danh sách agents và operators.
ASP_DB_URL=postgresql://postgres:CHANGE_ME@localhost:5432/asp_db

# Địa chỉ IP mà Server (Uvicorn/FastAPI) lắng nghe.
# Đặt 0.0.0.0 để cho phép nhận kết nối từ mọi giao diện mạng (localhost, WSL Ubuntu, hoặc máy Ubuntu khác trong LAN).
SOC_SERVER_HOST=0.0.0.0

# Cổng TCP mà Server lắng nghe các request HTTP (mặc định: 8000).
SOC_SERVER_PORT=8000

# Mức độ chi tiết khi ghi log vận hành của Server (DEBUG, INFO, WARNING, ERROR).
SOC_LOG_LEVEL=INFO

# Múi giờ mặc định dùng để quy đổi các dòng syslog truyền thống (RFC 3164 không kèm múi giờ, ví dụ: 'Oct 15 10:15:01')
# về giờ chuẩn UTC khi Agent gửi lên mà không khai báo trường timezone.
ASP_DEFAULT_TIMEZONE=Asia/Ho_Chi_Minh

# Độ lệch thời gian tương lai tối đa cho phép của sự kiện so với thời điểm Server nhận được (received_at).
# Giá trị '5m' (5 phút): nếu đồng hồ máy Agent chạy nhanh hơn Server quá 5 phút (event_ts > received_at + 5m),
# Server sẽ ép (clamp) event_ts về bằng received_at và bật cờ asp.ts_clamped = true để tránh làm hỏng cửa sổ phát hiện.
ASP_FUTURE_TS_TOLERANCE=5m

# Độ trễ tối đa cho phép đối với sự kiện đến muộn theo thời gian sự kiện (event-time), đồng thời là khoảng thời gian
# nạp lại (warm-up) các sự kiện từ DB vào bộ nhớ RAM khi khởi động lại Server.
# Giá trị '60s' (60 giây): sự kiện đến muộn hơn 60s so với mốc event_ts mới nhất vẫn được lưu DB nhưng không phát sinh alert trùng.
ASP_ALLOWED_LATENESS=60s

# Thời gian không hoạt động (idle) tối đa của một Hồ sơ vụ việc (Case) đang mở ('open' hoặc 'investigating').
# Giá trị '6h' (6 giờ tính theo event_ts): nếu có cảnh báo mới cùng khóa gom nhóm (rule_id + entity_key) xuất hiện
# trong vòng 6h kể từ last_activity_at thì gộp vào Case cũ; nếu quá 6h thì tự động đóng Case cũ ('closed') và mở Case mới.
ASP_CASE_IDLE_TIMEOUT=6h

# Đường dẫn thư mục chứa các file định nghĩa luật phát hiện (.yaml) mà Rule Engine sẽ nạp khi khởi động.
ASP_RULES_DIR=rules/

# Giới hạn tốc độ gửi log tối đa (Rate Limit) áp dụng cho mỗi Agent theo cơ chế Token Bucket (số request POST / phút).
# Giá trị 120 tương đương tối đa 120 batch/phút trên mỗi agent_id (vượt ngưỡng sẽ trả về HTTP 429 Too Many Requests).
ASP_RATE_LIMIT_INGEST=120

# ------------------------------------------------------------------------------
# 2. CẤU HÌNH AGENT CLIENT THU THẬP LOG (Dùng cho client/collector.py & client_setup.sh)
# ------------------------------------------------------------------------------

# Địa chỉ URL gốc của Server nhận log (không có dấu / ở cuối).
# - Nếu chạy Client ngay trên cùng máy với Server: http://localhost:8000
# - Nếu chạy Client trong WSL Ubuntu gọi ra Server trên Windows Host: http://172.19.240.1:8000
# - Nếu chạy Client trên máy ảo/máy vật lý Ubuntu khác: http://<IP-LAN-cua-Server>:8000
ASP_SERVER_URL=http://127.0.0.1:8000

# Mã định danh duy nhất của máy trạm Agent thu thập log (ví dụ: web-01).
# BẮT BUỘC phải khớp với agent_id đã tạo bằng công cụ tools/asp_admin.py và khớp với agent_id trong gói tin gửi lên.
ASP_AGENT_ID=web-01

# Khóa xác thực bí mật (Bearer API Key) dành riêng cho Agent ở trên (sinh ra từ lệnh: tools/asp_admin.py agent create).
# Server không lưu khóa thô này mà chỉ lưu mã băm SHA-256 kèm salt trong bảng agents để đối chiếu.
ASP_AGENT_API_KEY=CHANGE_ME_FROM_ASP_ADMIN

# Bật/tắt kiểm tra chứng chỉ số SSL/TLS khi Agent kết nối tới Server.
# Đặt 'false' khi chạy thử nghiệm qua HTTP hoặc dùng chứng chỉ tự ký (self-signed); đặt 'true' khi chạy HTTPS thực tế.
ASP_VERIFY_TLS=true

# ------------------------------------------------------------------------------
# 3. CẤU HÌNH OPERATOR / SOC ANALYST & AI AGENT (Dùng cho truy vấn API đọc & điều tra)
# ------------------------------------------------------------------------------

# Token xác thực bí mật (Bearer Token) của vận hành viên SOC hoặc AI Agent (sinh từ: tools/asp_admin.py operator create).
# Dùng để gọi các API đọc dữ liệu (/api/v1/alerts, /api/v1/events, /api/v1/cases) và kích hoạt điều tra (/api/v1/cases/{id}/investigate).
ASP_OP_TOKEN=CHANGE_ME_FROM_ASP_ADMIN

# ------------------------------------------------------------------------------
# 4. CẤU HÌNH TÍCH HỢP THREAT INTELLIGENCE (Tùy chọn cho Giai đoạn 6 - Agentic AI)
# ------------------------------------------------------------------------------
ABUSEIPDB_API_KEY=your_abuseipdb_api_key_here
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here
