# ==============================================================================
# Agentic SOC Platform - Environment Variables Template
# Copy this file to .env and modify as needed.
# ==============================================================================

# Server Network Configuration
SOC_SERVER_HOST=0.0.0.0
SOC_SERVER_PORT=8000
SOC_LOG_LEVEL=INFO

# External Threat Intelligence APIs (Optional for production)
ABUSEIPDB_API_KEY=your_abuseipdb_api_key_here
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here

# Detection Engine Settings
SSH_BRUTEFORCE_THRESHOLD=5
SSH_BRUTEFORCE_WINDOW_SECONDS=300

# Client Agent Configuration
SOC_AGENT_ID=agent-linux-node-01
SOC_SERVER_URL=http://127.0.0.1:8000
SOC_BATCH_SIZE=25
SOC_FLUSH_INTERVAL=3

